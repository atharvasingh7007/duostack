# Set default behaviour to automatically normalize line endings
* text=auto

# Ensure shell scripts always use LF (vital for Docker and Linux CI)
*.sh text eol=lf
Dockerfile text eol=lf
Jenkinsfile text eol=lf

# Documentation and code
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
