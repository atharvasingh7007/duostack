{
  "name": "duostack-core",
  "version": "0.1.0",
  "description": "Two-agent orchestration system bridging Claude Desktop and Antigravity",
  "type": "module",
  "bin": {
    "duostack": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "claude",
    "antigravity",
    "mcp",
    "coordination"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourname/duostack-core"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ]
}